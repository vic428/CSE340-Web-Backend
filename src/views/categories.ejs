<%- include('partials/header') %>

<main class="page">

    <header class="page-header">
        <p class="eyebrow">Ways to serve</p>
        <h1><%= title %></h1>
        <p class="lead">Every service project belongs to one of four categories. Pick the kind of work you care about most and find projects and partners that match.</p>
    </header>

    <!-- Category details -->
    <section class="home-section" aria-labelledby="categories-heading">
        <h2 id="categories-heading">Browse categories</h2>
        <div class="category-detail-grid">

            <article class="category-detail">
                <h3>Environmental</h3>
                <p>Protect and restore the natural spaces in our community through hands-on outdoor work.</p>
                <h4>Typical projects</h4>
                <ul class="plain-list">
                    <li>Park and trail cleanups</li>
                    <li>Tree planting and community gardens</li>
                    <li>Recycling and e-waste drives</li>
                </ul>
                <p class="category-partner">
                    <img src="/images/greenharvest-logo.png" alt="">
                    Featured partner: GreenHarvest Growers
                </p>
                <a class="text-link" href="/projects">See Park Cleanup</a>
            </article>

            <article class="category-detail">
                <h3>Educational</h3>
                <p>Help learners of all ages build skills and confidence through tutoring and mentoring.</p>
                <h4>Typical projects</h4>
                <ul class="plain-list">
                    <li>After-school tutoring</li>
                    <li>Adult literacy and job readiness</li>
                    <li>Youth mentoring programs</li>
                </ul>
                <p class="category-partner">
                    <img src="/images/brightfuture-logo.png" alt="">
                    Featured partner: BrightFuture Builders
                </p>
                <a class="text-link" href="/projects">See Community Tutoring</a>
            </article>

            <article class="category-detail">
                <h3>Community Service</h3>
                <p>Meet everyday needs and strengthen neighborhoods through direct, practical help.</p>
                <h4>Typical projects</h4>
                <ul class="plain-list">
                    <li>Food and clothing drives</li>
                    <li>Shelter and meal service support</li>
                    <li>Neighborhood events and home repair</li>
                </ul>
                <p class="category-partner">
                    <img src="/images/unityserve-logo.png" alt="">
                    Featured partner: UnityServe Volunteers
                </p>
                <a class="text-link" href="/projects">See Food Drive</a>
            </article>

            <article class="category-detail">
                <h3>Health and Wellness</h3>
                <p>Promote healthy living and connect neighbors with the care and resources they need.</p>
                <h4>Typical projects</h4>
                <ul class="plain-list">
                    <li>Community health fairs</li>
                    <li>Group fitness and walking clubs</li>
                    <li>Wellness check-ins for seniors</li>
                </ul>
                <p class="category-partner">
                    <img src="/images/unityserve-logo.png" alt="">
                    Featured partner: UnityServe Volunteers
                </p>
                <a class="text-link" href="/organizations">Meet the partners</a>
            </article>

        </div>
    </section>

    <!-- Not sure where to start -->
    <section class="home-section" aria-labelledby="start-heading">
        <h2 id="start-heading">Not sure where to start?</h2>
        <div class="feature-grid">
            <article class="feature-card">
                <h3>Short on time?</h3>
                <p>Environmental and Community Service projects are usually single-day events that need many hands for a few hours.</p>
            </article>
            <article class="feature-card">
                <h3>Want to go deeper?</h3>
                <p>Educational projects like tutoring run weekly, so you build real relationships with the people you help.</p>
            </article>
            <article class="feature-card">
                <h3>Bringing a group?</h3>
                <p>Health and Wellness events welcome families, classes, and teams and often have roles for every age.</p>
            </article>
        </div>
    </section>

    <!-- Call to action -->
    <section class="cta-banner" aria-labelledby="cta-heading">
        <h2 id="cta-heading">Found your category?</h2>
        <p>Head over to the projects page and sign up for an upcoming opportunity.</p>
        <a class="btn btn-light" href="/projects">View Upcoming Projects</a>
    </section>

</main>

<%- include('partials/footer') %>
