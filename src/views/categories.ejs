<%- include('partials/header') %>

<%
    // Format a Date as "November 14, 2026"
    const formatDate = (date) => new Date(date).toLocaleDateString('en-US', {
        year: 'numeric', month: 'long', day: 'numeric'
    });
%>

<main class="page">

    <header class="page-header">
        <p class="eyebrow">Ways to serve</p>
        <h1><%= title %></h1>
        <p class="lead">Every service project belongs to one of <%= categories.length %> categories. Pick the kind of work you care about most and find projects and partners that match.</p>
    </header>

    <!-- Category details -->
    <section class="home-section" aria-labelledby="categories-heading">
        <h2 id="categories-heading">Browse categories</h2>
        <div class="category-detail-grid">

            <% categories.forEach(category => { %>
                <% const categoryProjects = projects.filter(project => project.category_id === category.category_id); %>
                <article class="category-detail">
                    <h3><%= category.name %></h3>
                    <p><%= category.description %></p>

                    <h4>Upcoming projects (<%= category.project_count %>)</h4>
                    <% if (categoryProjects.length > 0) { %>
                        <ul class="plain-list">
                            <% categoryProjects.forEach(project => { %>
                                <li>
                                    <strong><%= project.name %></strong>
                                    with <%= project.organization_name %>
                                    on <%= formatDate(project.event_date) %>
                                </li>
                            <% }); %>
                        </ul>
                    <% } else { %>
                        <p class="category-empty">No projects scheduled yet. Check back soon.</p>
                    <% } %>

                    <a class="text-link" href="/projects">See all projects</a>
                </article>
            <% }); %>

        </div>
    </section>

    <!-- Not sure where to start -->
    <section class="home-section" aria-labelledby="start-heading">
        <h2 id="start-heading">Not sure where to start?</h2>
        <div class="feature-grid">
            <article class="feature-card">
                <h3>Short on time?</h3>
                <p>Environmental and Community Service projects are usually single-day events that need many hands for a few hours.</p>
            </article>
            <article class="feature-card">
                <h3>Want to go deeper?</h3>
                <p>Educational projects like tutoring run weekly, so you build real relationships with the people you help.</p>
            </article>
            <article class="feature-card">
                <h3>Bringing a group?</h3>
                <p>Health and Wellness events welcome families, classes, and teams and often have roles for every age.</p>
            </article>
        </div>
    </section>

    <!-- Call to action -->
    <section class="cta-banner" aria-labelledby="cta-heading">
        <h2 id="cta-heading">Found your category?</h2>
        <p>Head over to the projects page and sign up for an upcoming opportunity.</p>
        <a class="btn btn-light" href="/projects">View Upcoming Projects</a>
    </section>

</main>

<%- include('partials/footer') %>
