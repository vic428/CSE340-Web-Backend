<%- include('partials/header') %>

<main class="page">

    <header class="page-header">
        <p class="eyebrow">Service project</p>
        <h1><%= title %></h1>
        <p class="lead">Update the details for <%= project.name %>. Every field is required unless marked optional.</p>
    </header>

    <section class="home-section">

        <form class="form" action="/edit-project/<%= project.project_id %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input
                    type="text"
                    id="title"
                    name="title"
                    value="<%= project.name %>"
                    maxlength="150"
                    required
                />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea
                    id="description"
                    name="description"
                    rows="5"
                    aria-describedby="description-hint"
                    maxlength="1000"
                    required
                ><%= project.description %></textarea>
                <p class="form-hint" id="description-hint">What volunteers will do and who the project helps.</p>
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select
                    id="organizationId"
                    name="organizationId"
                    required
                >
                    <option value="">Select an organization</option>
                    <% organizations.forEach(org => { %>
                        <option
                            value="<%= org.organization_id %>"
                            <%= org.organization_id === project.organization_id ? 'selected' : '' %>
                        ><%= org.name %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input
                    type="text"
                    id="location"
                    name="location"
                    value="<%= project.location %>"
                    maxlength="200"
                    required
                />
            </div>

            <div class="form-group">
                <label for="date">Date</label>
                <input
                    type="date"
                    id="date"
                    name="date"
                    value="<%= formValues.date %>"
                    required
                />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="startTime">Start Time</label>
                    <input
                        type="time"
                        id="startTime"
                        name="startTime"
                        value="<%= formValues.startTime %>"
                        required
                    />
                </div>

                <div class="form-group">
                    <label for="endTime">End Time</label>
                    <input
                        type="time"
                        id="endTime"
                        name="endTime"
                        value="<%= formValues.endTime %>"
                        required
                    />
                </div>
            </div>

            <div class="form-group">
                <label for="volunteersNeeded">Volunteers Needed</label>
                <input
                    type="number"
                    id="volunteersNeeded"
                    name="volunteersNeeded"
                    value="<%= project.volunteers_needed %>"
                    min="1"
                    max="10000"
                    step="1"
                    inputmode="numeric"
                    required
                />
            </div>

            <div class="form-group">
                <label for="recurrence">Recurrence <span class="form-optional">(optional)</span></label>
                <input
                    type="text"
                    id="recurrence"
                    name="recurrence"
                    value="<%= project.recurrence || '' %>"
                    aria-describedby="recurrence-hint"
                    maxlength="100"
                />
                <p class="form-hint" id="recurrence-hint">Leave blank for a one-time project, or describe the schedule, for example "Every Tuesday".</p>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Update Project</button>
                <a class="btn btn-secondary" href="/project/<%= project.project_id %>">Cancel</a>
            </div>
        </form>

        <p class="form-hint">To change this project's categories, use <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>.</p>

    </section>

</main>

<%- include('partials/footer') %>
