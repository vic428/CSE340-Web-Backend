<%- include('partials/header') %>

<main class="page">

    <header class="page-header">
        <p class="eyebrow">Grow the network</p>
        <h1><%= title %></h1>
        <p class="lead">Tell us about the organization you would like to add. All fields are required.</p>
    </header>

    <section class="home-section">

        <form class="form" action="/new-organization" method="POST">
            <div class="form-group">
                <label for="name">Organization Name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    autocomplete="organization"
                    maxlength="150"
                    required
                />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea
                    id="description"
                    name="description"
                    rows="5"
                    aria-describedby="description-hint"
                    maxlength="500"
                    required
                ></textarea>
                <p class="form-hint" id="description-hint">A sentence or two about what the organization does and who it serves.</p>
            </div>

            <div class="form-group">
                <label for="contactEmail">Contact Email</label>
                <input
                    type="email"
                    id="contactEmail"
                    name="contactEmail"
                    autocomplete="email"
                    placeholder="name@example.org"
                    required
                />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create Organization</button>
                <a class="btn btn-secondary" href="/organizations">Cancel</a>
            </div>
        </form>

    </section>

</main>

<%- include('partials/footer') %>
