<%- include('partials/header') %>

<main class="page">

    <header class="page-header">
        <p class="eyebrow">Get involved</p>
        <h1><%= title %></h1>
        <p class="lead">Browse upcoming opportunities to serve. Each project is hosted by one of our partner organizations and open to volunteers of all experience levels.</p>
    </header>

    <%
        // Format a Date as "Saturday, November 14, 2026" (or without the weekday)
        const formatDate = (date, withWeekday = true) => new Date(date).toLocaleDateString('en-US', {
            ...(withWeekday && { weekday: 'long' }), year: 'numeric', month: 'long', day: 'numeric'
        });

        // Format a "HH:MM:SS" time string as "9:00 AM"
        const formatTime = (time) => {
            const [hours, minutes] = time.split(':').map(Number);
            const period = hours >= 12 ? 'PM' : 'AM';
            const twelveHour = hours % 12 || 12;
            return `${twelveHour}:${String(minutes).padStart(2, '0')} ${period}`;
        };
    %>

    <!-- Upcoming projects -->
    <section class="home-section" aria-labelledby="upcoming-heading">
        <h2 id="upcoming-heading">Upcoming service projects</h2>
        <div class="project-list">

            <% projects.forEach(project => { %>
                <article class="project-card">
                    <div class="project-host">
                        <img src="/images/<%= project.logo_filename %>" alt="<%= project.organization_name %> logo">
                        <span>Hosted by <%= project.organization_name %></span>
                    </div>
                    <h3>
                        <span class="project-date"><%= formatDate(project.event_date) %>:</span>
                        <%= project.name %> (<%= project.organization_name %>)
                    </h3>
                    <p class="tag-row"><span class="tag"><%= project.category %></span></p>
                    <p><%= project.description %></p>
                    <dl class="detail-list">
                        <div>
                            <dt>When</dt>
                            <dd>
                                <% if (project.recurrence) { %><%= project.recurrence %> starting <% } %>
                                <%= formatDate(project.event_date, !project.recurrence) %> · <%= formatTime(project.start_time) %> to <%= formatTime(project.end_time) %>
                            </dd>
                        </div>
                        <div><dt>Where</dt><dd><%= project.location %></dd></div>
                        <div><dt>Volunteers needed</dt><dd><%= project.volunteers_needed %></dd></div>
                    </dl>
                    <a class="btn btn-primary" href="mailto:<%= project.contact_email %>?subject=<%= encodeURIComponent(project.name + ' volunteer') %>">Sign Up</a>
                </article>
            <% }); %>

        </div>
    </section>

    <!-- What to expect -->
    <section class="home-section" aria-labelledby="expect-heading">
        <h2 id="expect-heading">What to expect</h2>
        <div class="feature-grid">
            <article class="feature-card">
                <span class="feature-step" aria-hidden="true">1</span>
                <h3>Sign up</h3>
                <p>Choose a project and send a quick note to the host organization. They will confirm your spot and share any details.</p>
            </article>
            <article class="feature-card">
                <span class="feature-step" aria-hidden="true">2</span>
                <h3>Show up</h3>
                <p>Arrive a few minutes early, check in with the project leader, and get a short orientation before work begins.</p>
            </article>
            <article class="feature-card">
                <span class="feature-step" aria-hidden="true">3</span>
                <h3>Serve together</h3>
                <p>Work alongside neighbors and partner staff. Most projects wrap up with a brief debrief so you can see the results.</p>
            </article>
        </div>
    </section>

    <!-- Call to action -->
    <section class="cta-banner" aria-labelledby="cta-heading">
        <h2 id="cta-heading">Looking for something specific?</h2>
        <p>Projects are grouped into four categories so you can find the kind of service that fits you best.</p>
        <a class="btn btn-light" href="/categories">Browse by Category</a>
    </section>

</main>

<%- include('partials/footer') %>
