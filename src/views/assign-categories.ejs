<%- include('partials/header') %>

<main class="page">

    <header class="page-header">
        <p class="eyebrow">Service project</p>
        <h1><%= projectDetails.title %></h1>
        <p class="lead">Choose every category that describes this project.</p>
    </header>

    <section class="home-section" aria-labelledby="assign-heading">

        <form class="form" action="/assign-categories/<%= projectId %>" method="POST">
            <fieldset class="checkbox-group">
                <legend id="assign-heading">Assign Categories</legend>

                <% categories.forEach(category => { %>
                    <div class="checkbox-option">
                        <input
                            type="checkbox"
                            id="category-<%= category.category_id %>"
                            name="categoryIds"
                            value="<%= category.category_id %>"
                            <%= assignedCategories.some(ac => ac.category_id === category.category_id) ? 'checked' : '' %>
                        />
                        <label for="category-<%= category.category_id %>"><%= category.name %></label>
                    </div>
                <% }); %>
            </fieldset>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Update Categories</button>
                <a class="btn btn-secondary" href="/project/<%= projectId %>">Cancel</a>
            </div>
        </form>

    </section>

</main>

<%- include('partials/footer') %>
